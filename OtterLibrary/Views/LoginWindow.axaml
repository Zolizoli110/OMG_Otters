<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:OtterLibrary.ViewModels"
        x:Class="OtterLibrary.Views.LoginWindow"

        Title="OtterLibrary"
        Width="800"
        Height="450"
        x:CompileBindings="False">

    
    

    <StackPanel HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Width="250"
                Spacing="10">

        <TextBlock Text="Login"
                   FontSize="20"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,10"/>

        <TextBlock Text="Username" />
        <TextBox Watermark="Enter username"
                 Text="{Binding UsernameInput}" />

        <TextBlock Text="Password" />
        <TextBox Watermark="Enter password"
                 Text="{Binding PasswordInput}"
                 PasswordChar="*" />

       

        <Button Content="Sign In"
                Command="{Binding SignInCommand}"
                CommandParameter="{Binding }"
                HorizontalAlignment="Center"
                
                Margin="0,10,0,0"/>

        <TextBlock Text="{Binding LoginResult}"
                   TextAlignment="Center"
                   Margin="0,10,0,0"/>

    </StackPanel>
</Window>