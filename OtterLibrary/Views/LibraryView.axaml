<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:OtterLibrary.ViewModels"
             xmlns:m="using:OtterLibrary.Models"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:DataType="vm:LibraryViewModel"
             x:Class="OtterLibrary.Views.LibraryView">
    <Design.DataContext>
        <vm:LibraryViewModel />
    </Design.DataContext>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <ItemsControl ItemsSource="{Binding Books}">
        <ItemsControl.ItemsPanel>
			<ItemsPanelTemplate>
				<WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Top" ItemWidth="220" ItemHeight="500"/>
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
            <DataTemplate DataType="m:Book">
                <Border
                    MaxWidth="200"
                    Padding="10"
                    Margin="10"
                    BorderThickness="2"
                    BorderBrush="Black">
					<StackPanel>
                        <Image Height="200" Width="120" 
                               Stretch="UniformToFill"
                               Source="avares://OtterLibrary/Assets/1984.jpg"/>
                        <Separator Margin="-10,5,-10,5"/>
					    <TextBlock Text="{Binding Title}" TextWrapping="Wrap" ClipToBounds="True" Height="50" FontSize="18" FontWeight="Black" TextAlignment="Center"/>
                        <TextBlock  FontStyle="Italic" TextWrapping="Wrap" ClipToBounds="True" FontSize="12">
					    	<Run Text="Written by"/>
                            <Run Text="{Binding Author}" FontWeight="DemiBold"/>
                        </TextBlock>
                        <TextBlock  FontSize="12" TextAlignment="Center">
					    	<Run Text="ISBN: "/>
                            <Run Text="{Binding ISBN}" />
                        </TextBlock>
                        <Separator Margin="-10,5,-10,5"/>
                        <TextBlock FontSize="12" TextWrapping="Wrap" Height="120" ClipToBounds="True">
					    	<Run Text="Description:" TextDecorations="Underline"/>
                            <Run Text="{Binding Description}"/>
                        </TextBlock>
                        <Separator Margin="-10,5,-10,5"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8" Margin="-10,0,0,0">
                            <Button Content="Delete" HorizontalAlignment="Center" IsVisible="{Binding $parent[ItemsControl].((vm:LibraryViewModel)DataContext).SeeLibrarianStuff}"/>
                            <Button Content="Borrow" HorizontalAlignment="Center" IsVisible="{Binding $parent[ItemsControl].((vm:LibraryViewModel)DataContext).SeeMemberStuff}"/>
                            <Button Content="Edit" HorizontalAlignment="Center" IsVisible="{Binding $parent[ItemsControl].((vm:LibraryViewModel)DataContext).SeeLibrarianStuff}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
    </ScrollViewer>
</UserControl>
