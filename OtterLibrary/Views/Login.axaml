<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="OtterLibrary.Login"
        Title="Login">

  <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock Text="Username:" Margin="10" HorizontalAlignment="Center"/>
        <TextBox Name="UsernameTextBox" Margin="10" Width="200"/>
        <TextBlock Text="Password:" Margin="10" HorizontalAlignment="Center"/>
        <TextBox Name="PasswordTextBox" Margin="10" PasswordChar="*" Width="200"/>
        <Button Content="Sign In" Margin="10" Click="SignInButton_Click" HorizontalAlignment="Center"/>
    </StackPanel>
</Window>
